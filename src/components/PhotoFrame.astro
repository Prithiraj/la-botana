---
const {
  src,
  alt = '',
  className = '',
  eager = false,
  caption = '',
  source = ''
} = Astro.props;
---
<figure class={`photo-block ${className}`.trim()}>
  <div class="photo-frame">
    <div class="photo-fallback" aria-hidden="true">La Botana photo</div>
    <img
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="this.remove()"
    />
  </div>
  {(caption || source) && <figcaption class="photo-caption">{caption || source}</figcaption>}
</figure>
