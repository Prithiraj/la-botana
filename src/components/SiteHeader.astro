---
const { current = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path = '') => `${base}${path}`;
---
<header class="site-header">
  <a class="skip-link" href="#main">Skip to main content</a>
  <div class="shell header-inner">
    <a class="wordmark" href={href('')} aria-label="La Botana home">
      <span class="wordmark-mark" aria-hidden="true"></span>
      <span>LA BOTANA</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={href('menu/')} aria-current={current === 'menu' ? 'page' : undefined}>Menu</a>
      <a href={href('#what-to-expect')}>What to expect</a>
      <a href={href('visit/')} aria-current={current === 'visit' ? 'page' : undefined}>Visit</a>
      <a class="btn btn-primary" href="https://www.google.com/maps/search/?api=1&query=La+Botana%2C+2415+State+Road+60+E%2C+Lake+Wales%2C+FL+33898" target="_blank" rel="noreferrer">Get directions</a>
    </nav>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
  </div>
  <nav id="mobile-menu" class="mobile-menu" data-open="false" aria-label="Mobile navigation">
    <div class="shell">
      <a href={href('menu/')} aria-current={current === 'menu' ? 'page' : undefined}>Menu</a>
      <a href={href('#what-to-expect')}>What to expect</a>
      <a href={href('visit/')} aria-current={current === 'visit' ? 'page' : undefined}>Visit</a>
      <a href="https://www.google.com/maps/search/?api=1&query=La+Botana%2C+2415+State+Road+60+E%2C+Lake+Wales%2C+FL+33898" target="_blank" rel="noreferrer">Get directions ↗</a>
    </div>
  </nav>
</header>

<script is:inline>
  const button = document.querySelector('.nav-toggle');
  const menu = document.querySelector('#mobile-menu');
  if (button && menu) {
    const closeMenu = () => {
      button.setAttribute('aria-expanded', 'false');
      menu.setAttribute('data-open', 'false');
    };
    button.addEventListener('click', () => {
      const next = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(next));
      menu.setAttribute('data-open', String(next));
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
        button.focus();
      }
    });
  }
</script>
